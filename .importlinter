[importlinter]
root_package = weightroom
include_external_packages = True

[importlinter:contract:layers]
name = WeightRoomGym internal layering
type = layers
layers =
    web
    cli
    services
    domain
containers = weightroom

[importlinter:contract:web-cli-independence]
name = Web and CLI never import each other
type = independence
modules =
    weightroom.web
    weightroom.cli

[importlinter:contract:domain-purity]
name = Domain imports no frameworks
type = forbidden
source_modules = weightroom.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    typer
    httpx
    jinja2
    tomlkit
    cryptography

[importlinter:contract:no-application-imports]
name = WeightRoomGym reaches the four applications only over HTTP, their CLIs and their databases (ADR-0123 rule 3) — never by import
type = forbidden
source_modules = weightroom
forbidden_modules =
    freeweight
    loadcoach
    ideapress
    promptcadence

[importlinter:contract:no-agent-packages]
name = WeightRoomGym runs no tools and compacts no transcripts of its own (ADR-0123 rule 4)
type = forbidden
source_modules = weightroom
forbidden_modules =
    toolyard
    cutctx
    commissioner

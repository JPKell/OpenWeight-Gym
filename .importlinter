[importlinter]
root_package = weightroom
include_external_packages = True

[importlinter:contract:layers]
name = WeightRoomGym internal layering
type = layers
# Parenthesised = optional: the empty package has none of these yet. W1 removes the parentheses
# as each layer appears, so a missing layer becomes a failure again once it has been written.
layers =
    (web)
    (cli)
    (services)
    (domain)
containers = weightroom

# W1 adds the sibling repositories' `web-cli-independence` contract (type = independence over
# weightroom.web and weightroom.cli) the moment both modules exist; an independence contract
# over absent modules is an error rather than a pass, so it cannot be declared ahead of them.

# W1 also adds `domain-purity` (type = forbidden, source weightroom.domain, forbidding fastapi,
# starlette, sqlalchemy, typer, httpx, jinja2, tomlkit and cryptography) once weightroom.domain
# exists — the same reason as above: a contract over an absent source module is an error.

[importlinter:contract:no-application-imports]
name = WeightRoomGym reaches the four applications only over HTTP, their CLIs and their databases (ADR-0123 rule 3) — never by import
type = forbidden
source_modules = weightroom
forbidden_modules =
    freeweight
    loadcoach
    ideapress
    promptcadence

[importlinter:contract:no-agent-packages]
name = WeightRoomGym runs no tools and compacts no transcripts of its own (ADR-0123 rule 4)
type = forbidden
source_modules = weightroom
forbidden_modules =
    toolyard
    cutctx
    commissioner
